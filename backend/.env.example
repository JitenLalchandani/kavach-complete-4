# ==========================================
# KAVACH BACKEND - ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in real values.
# Never commit the real .env file to version control.
# ==========================================

# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kavach

# JWT Auth
JWT_SECRET=kavach_super_secret_key_123
JWT_EXPIRES_IN=7d

# ------------------------------------------
# AI Integration (Anthropic Claude API)
# Get a key at https://console.anthropic.com/
# ------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ------------------------------------------
# WhatsApp Integration (Twilio)
# Get credentials at https://console.twilio.com/
# ------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
CYBER_CRIME_WHATSAPP_NUMBER=whatsapp:+919624251798

# ------------------------------------------
# NumVerify — Phone carrier detection (Jio/Airtel/VI etc.)
# Free API key at https://numverify.com
# ------------------------------------------
NUMVERIFY_API_KEY=

# ------------------------------------------
# Truecaller — Spam/scam number detection
# Apply at https://truecaller.com/blog/truecaller-api
# ------------------------------------------
TRUECALLER_API_KEY=

# ------------------------------------------
# Google Safe Browsing — Phishing/malware link detection
# Free API key at https://developers.google.com/safe-browsing
# ------------------------------------------
GOOGLE_SAFE_BROWSING_KEY=

# Cron schedule for daily wellness sweep (default 6 PM)
WELLNESS_CRON_SCHEDULE=0 18 * * *
INACTIVITY_THRESHOLD_HOURS=30
